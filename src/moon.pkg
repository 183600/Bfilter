import {
  "moonbitlang/core/double",
  "moonbitlang/core/hashmap",
  "moonbitlang/core/math",
  "moonbitlang/core/ref",
}

import {
  "moonbitlang/core/bench",
} for "test"

options(
  "is-main": false,
  "native-stub": [ "mutex_stub.c" ],
  targets: {
    "mutex_native.mbt": [ "native", "llvm" ],
    "mutex_single_threaded.mbt": [ "js", "wasm", "wasm-gc" ],
  },
  readme: "README.md",
  description: "Bloom, counting, scalable, and Cuckoo filters for MoonBit with serialization and concurrency wrappers",
  version: "0.1.0",
  authors: [ ],
  license: "MIT",
  keywords: [
    "bloom-filter",
    "cuckoo-filter",
    "counting-bloom-filter",
    "probabilistic",
    "data-structure",
    "concurrent",
  ],
  repository: "https://github.com/183600/Bfilter",
)
